        <rdfs:label xml:lang="pl">Camera</rdfs:label>
    </owl:Class>



    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#CollectiveRoboticSystem -->

    <owl:Class rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#CollectiveRoboticSystem">
        <rdfs:subClassOf rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#RoboticSystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#hasPart"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Robot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#hasPart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#RobotGroup"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#SingleRoboticSystem"/>
    </owl:Class>



    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Conclusion -->

    <owl:Class rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Conclusion">
        <rdfs:subClassOf rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Rules"/>
        <rdfs:label xml:lang="pl">Conclusion</rdfs:label>
    </owl:Class>



    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#ConclusionsAssessment -->

    <owl:Class rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#ConclusionsAssessment">
        <rdfs:subClassOf rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Project"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#hasConclusion"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Conclusion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#isEvaluated"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pl">ConclusionsAssessments</rdfs:label>
    </owl:Class>



