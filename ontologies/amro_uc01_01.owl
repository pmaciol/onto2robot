    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Action -->

    <owl:Class rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Action">
        <rdfs:subClassOf rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#Process"/>
        <owl:disjointWith rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#ConclusionsAssessment"/>
        <rdfs:label xml:lang="pl">Action</rdfs:label>
    </owl:Class>



    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#ActiveSensor -->

