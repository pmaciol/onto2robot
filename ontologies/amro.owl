    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#Region -->

    <owl:Class rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#Region">
        <rdfs:subClassOf rdf:resource="http://purl.org/ieee1872-owl/sumo-cora#Device"/>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Action -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Action">
        <rdfs:subClassOf rdf:resource="http://purl.org/ieee1872-owl/sumo-cora#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#isRepresentedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyInstances"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#ConclusionsAssessment"/>
        <rdfs:label xml:lang="pl">Action</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#ActiveSensor -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#ActiveSensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#SensorTypes"/>
        <rdfs:label xml:lang="pl">ActiveSensors</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Bisector -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Bisector">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#DefuzzificationMethods"/>
        <rdfs:label xml:lang="pl">Bisector</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Camera -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Camera">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#PassiveSensors"/>
        <rdfs:label xml:lang="pl">Camera</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Centroid -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Centroid">
