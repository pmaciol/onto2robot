        <rdfs:label xml:lang="pl">Centroid</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Conclusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Conclusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Rules"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#hasLeftHand"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Action"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#ConclusionsAssessment"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#hasRightHand"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#LinguisticValues"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pl">Conclusion</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#ConclusionsAssessment -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#ConclusionsAssessment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Rules"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#isRepresentedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyInstances"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#SensorUsed"/>
        <rdfs:label xml:lang="pl">ConclusionsAssessments</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#DefuzzificationMethods -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#DefuzzificationMethods">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Fuzzy"/>
        <rdfs:label xml:lang="pl">DefuzzificationMethods</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Fuzzy -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Fuzzy">
        <rdfs:subClassOf rdf:resource="http://purl.org/ieee1872-owl/sumo-cora#Abstract"/>
        <rdfs:label xml:lang="pl">Fuzzy</rdfs:label>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyInstances -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyInstances">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Fuzzy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#isTypeOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyVariablesTypes"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#uses"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#DefuzzificationMethods"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#uses"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyficationMethods"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#has1.Parameter"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#hasParameters"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyVariablesTypes -->

    <owl:Class rdf:about="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyVariablesTypes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#Fuzzy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#hasValues"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/amaci/ontologies/2026/0/amro#LinguisticValues"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>



    <!-- http://www.semanticweb.org/amaci/ontologies/2026/0/amro#FuzzyficationMethods -->

