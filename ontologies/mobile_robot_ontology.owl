        <rdf:type rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#RulesSets" />
        <contains rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#R33" />
