                            <owl:Class>
                                <owl:complementOf
                                    rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Robot" />
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


