    <!-- http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#RoboticSystem -->

    <owl:Class rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#RoboticSystem">
        <rdfs:subClassOf
            rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/coraX.owl#ArtificialSystem" />
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty
                    rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#isSupportedBy" />
                <owl:minQualifiedCardinality
                    rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description
                                rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#Device" />
                            <owl:Class>
                                <owl:complementOf
                                    rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Robot" />
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty
                    rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#hasPart" />
                <owl:minQualifiedCardinality
                    rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass
                    rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/cora.owl#Robot" />
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty
                    rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#hasPart" />
                <owl:minQualifiedCardinality
                    rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description
