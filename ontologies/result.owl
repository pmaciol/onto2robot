<owl:Class rdf:about="#RoboticEnvironment">
  <rdfs:subClassOf rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/coraX.owl#PhysicalEnvironment"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#equippedWith"/>
      <owl:onClass rdf:resource="#RoboticSystem"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#RoboticSystem">
  <rdfs:subClassOf rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/coraX.owl#ArtificialSystem"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#isSupportedBy"/>
      <owl:onClass>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#Device"/>
            <owl:Class>
              <owl:complementOf rdf:resource="#Robot"/>
            </owl:Class>
          </owl:intersectionOf>
        </owl:Class>
      </owl:onClass>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#hasPart"/>
      <owl:onClass rdf:resource="#Robot"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#hasPart"/>
      <owl:onClass>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.inf.ufrgs.br/phi-group/ontologies/sumo.owl#Device"/>
            <owl:Class>
              <owl:complementOf rdf:resource="#Robot"/>
            </owl:Class>
          </owl:intersectionOf>
        </owl:Class>
      </owl:onClass>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

